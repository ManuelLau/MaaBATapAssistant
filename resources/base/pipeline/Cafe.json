{
	"MoveToCafe1": {
		"next": [
			"[JumpBack]ClosePopup",
			"MoveToCafe1@InCafe1",
			"MoveToCafe1@InCafe2",
			"Cafe@EnterCafe",
			"[JumpBack]WaitLoading",
			"[JumpBack]DisconnectPopup",
			"[JumpBack]CloseReward",
			"[JumpBack]ClickHomeButton",
			"[JumpBack]IdelTapScreen"
		],
		"doc": "可以在任何地方进入到1号咖啡厅"
	},
	"MoveToCafe1@InCafe1":{
		"recognition": {
			"type": "OCR",
			"param": {
				"roi": [38, 76, 192, 54],
				"expected": ["2号店"],
				"replace": [
					["'", ""]
				],
				"threshold": 0.9
			}
		},
		"next": "Stop"
	},
	"MoveToCafe1@InCafe2": {
		"recognition": {
			"type": "OCR",
			"param": {
				"roi": [38, 76, 192, 54],
				"expected": ["1号店"],
				"replace": [
					["'", ""]
				],
				"threshold": 0.9
			}
		},
		"action": {
			"type": "Click",
			"param": {
				"target": [140, 100, 2, 2]
			}
		},
		"post_delay": 1000,
		"next": [
			"Cafe@RecognizeTopLeftText",
			"[JumpBack]WaitLoading"
		]
	},

	"MoveToCafe2": {
		"next": [
			"[JumpBack]ClosePopup",
			"MoveToCafe2@InCafe2",
			"MoveToCafe2@InCafe1",
			"[JumpBack]WaitLoading",
			"[JumpBack]CloseReward",
			"[JumpBack]ClickHomeButton",
			"[JumpBack]IdelTapScreen",
			"[JumpBack]Cafe@EnterCafe"
		]
	},
	"MoveToCafe2@InCafe2":{
		"recognition": {
			"type": "OCR",
			"param": {
				"roi": [38, 76, 192, 54],
				"expected": ["1号店"],
				"replace": [
					["'", ""]
				],
				"threshold": 0.9
			}
		},
		"next": "Stop"
	},
	"MoveToCafe2@InCafe1": {
		"recognition": {
			"type": "OCR",
			"param": {
				"roi": [38, 76, 192, 54],
				"expected": ["2号店"],
				"replace": [
					["'", ""]
				],
				"threshold": 0.9
			}
		},
		"action": {
			"type": "Click",
			"param": {
				"target": [140, 100, 2, 2]
			}
		},
		"post_delay": 1000,
		"next": [
			"Cafe@RecognizeTopLeftText",
			"[JumpBack]WaitLoading"
		]
	},

	"Cafe@ClickCafeButton": {
		"recognition": "TemplateMatch",
		"template": "CafeButton.png",
		"roi": [0, 600, 150, 120],
		"action": "Click",
		"post_delay": 1000
	},

	"Cafe@EnterCafe": {
		"recognition": "TemplateMatch",
		"template": "CafeButton.png",
		"roi": [0, 600, 150, 120],
		"action": "Click",
		"post_delay": 1000,
		"next": [
			"[JumpBack]ClosePopup",
			"Cafe@RecognizeTopLeftText",
			"[JumpBack]WaitLoading",
			"[JumpBack]Cafe@ClickCafeButton"
		],
		"doc": "从主界面进入咖啡厅。默认进入1号咖啡厅，所以使用另外的pipeline"
	},
	"Cafe@RecognizeTopLeftText": {
		"recognition": "TemplateMatch",
		"template": "CafeTopLeftText.png",
		"roi": [84, 0, 218, 50],
		"post_delay": 1000,
		"next": [
			"[JumpBack]Cafe@RecognizeFirstTimePopup",
			"[JumpBack]ClosePopup",
			"Cafe@RecognizeEarningsButton",
			"[JumpBack]WaitLoading"
		],
		"doc": "第一个任务检查点：识别左上角文字。确保进入到了咖啡厅，但是可能会有弹窗出现。进入后等待2秒"
	},
	"Cafe@RecognizeEarningsButton":{
		"recognition": "ColorMatch",
		"roi": [1234, 660, 6, 6],
		"lower": [35, 60, 89],
		"upper": [55, 80, 109],
		"count": 32,
		"doc": "识别咖啡厅收益按钮处的色值判断是否关闭了所有弹窗"
	},
	"Cafe@RecognizeFirstTimePopup": {
		"recognition": "TemplateMatch",
		"template": "VisitingStudentsList.png",
		"roi": [500, 116, 288, 200],
		"next": "ClosePopup",
		"doc": "检查并关闭该时间段首次进入咖啡厅的弹窗"
	},

	"Cafe@ClickUnfoldButton": {
		"recognition": "TemplateMatch",
		"template": "CafeUnfoldButton.png",
		"roi": [20, 585, 80, 80],
		"action": "Click",
		"post_delay": 1000,
		"doc": "点击底部左侧UI栏的展开按钮"
	}
}